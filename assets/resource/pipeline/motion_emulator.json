{
    // 初版骨架：任务链已定，识别细节（TemplateMatch/OCR + 图像素材）待实测截图后填充。
    // 协议文档：https://maafw.com/docs/3.1-PipelineProtocol
    //
    // 业务背景（来自 motion-emulate-automation 的实测经验）：
    // - 西工大体育 (net.crigh.xbgysport)：首次启动有 隐私协议弹窗(同意) → 引导页(3次左滑 → tv_start)
    //   → 登录页(勾选 checkRule 协议 → btn_login 进 CAS webview → username/password → 登录)
    // - Motion Emulator (com.zhufucdev.motion_emulator)：首页是单列滚动卡片，模拟 卡在最底部
    //   → 表单 dropdown_trace(需已选路线) / input_repeat_count(2.4km→6, 3.2km→8) / btn_run_emulation
    // - MuMu 多 display：app 可能落在副屏，操作前需确认 display（MaaFW Adb 控制器已处理截图/输入路由）
    //
    // "FullRun": 登录 → 启动模拟 → 开始锻炼 → 等待锻炼结束 的完整链路

    "FullRun": {
        "recognition": "DirectHit",
        "action": "Shell",
        "cmd": "am force-stop net.crigh.xbgysport; am force-stop com.zhufucdev.motion_emulator",
        "next": ["SportLogin"]
        // 实测踩坑：体育 app 进程跨「保存记录」后位置会话会卡死（运动页 计时 00:00:00、
        // GPS 2/3、正在加载数据... 转圈，模拟 GPS 永远进不来）。FullRun 起点先强停两个
        // app，保证每次都是全新会话
    },
    "SportLogin": {
        "recognition": "DirectHit",
        "action": "StartApp",
        "package": "net.crigh.xbgysport",
        "timeout": 30000,
        "next": [
            "SportLogin-已登录主页",
            "SportLogin-已运动中",
            "SportLogin-记录详情页",
            "SportLogin-隐私协议",
            "SportLogin-登录页勾选"
        ]
        // 状态机：StartApp 后按序轮询，首个命中进入对应分支。
        // 注意：引导页节点刻意不在此列表——首启时 WelcomeActivity 会先渲染引导
        // ViewPager、隐私弹窗延迟数秒才盖上（实测踩坑：引导页抢命中→未同意协议
        // 点开始→app 退出）。引导页只能从"已同意"（隐私协议.next）进入。
    },

    // 上轮保存后冷启动会恢复到记录详情页（实测踩坑）：返回键退出到主页
    "SportLogin-记录详情页": {
        "recognition": "OCR",
        "expected": "平均配速",
        "roi": [0, 400, 720, 400],
        "action": "Click",
        "target": [53, 54],
        "next": ["SportLogin-已登录主页", "SportLogin-已运动中", "SportLogin-记录详情页"]
        // 左上返回箭头（原生 [40,42][174,176] -> 720p 中心 (53,54)）；
        // 返回后可能落主页或运动中页（栈恢复）
    },

    // ---- 已登录分支 ----
    "SportLogin-已登录主页": {
        "recognition": "TemplateMatch",
        "template": "sport/home_exercise_entry.png",
        "roi": [0, 500, 720, 620],
        "threshold": 0.8,
        "action": "DoNothing",
        "next": ["StartEmulation"]
    },

    // FullRun 重跑保护：已在运动中（上轮链完成/中断恢复）直接跳到模拟段
    "SportLogin-已运动中": {
        "recognition": "OCR",
        "expected": ["运动中", "暂停"],
        "roi": [0, 0, 720, 1280],
        "action": "DoNothing",
        "next": ["StartEmulation"]
        // 运动中页：顶部标题 运动中（暂停态为 运动暂停中，不含 运动中 连续字样）+
        // 底部 暂停 按钮字样，任一命中即认定锻炼进行中
    },

    // ---- 首启隐私弹窗（同意/拒绝）----
    "SportLogin-隐私协议": {
        "recognition": "TemplateMatch",
        "template": "sport/privacy_agree_btn.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["SportLogin-引导页", "SportLogin-登录页勾选", "SportLogin-已登录主页"]
    },

    // ---- 引导页（实测 tv_start 首页即可见，直接点击跳过，无需左滑）----
    "SportLogin-引导页": {
        "recognition": "TemplateMatch",
        "template": "sport/guide_start_btn.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["SportLogin-登录页勾选", "SportLogin-已登录主页"]
    },

    // ---- 登录页：自旋勾选协议（未勾选态 checkbox 模板；勾选后不再命中），勾上后 CAS 入口变亮 ----
    "SportLogin-登录页勾选": {
        "recognition": "TemplateMatch",
        "template": "sport/login_checkrule.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["SportLogin-打开CAS", "SportLogin-登录页勾选"]
    },

    // 勾选后的亮态入口按钮（灰态匹配不到，天然防误点）
    "SportLogin-打开CAS": {
        "recognition": "TemplateMatch",
        "template": "sport/cas_entry_active.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["SportLogin-CAS用户名"]
    },

    // ---- CAS 统一身份认证 webview ----
    "SportLogin-CAS用户名": {
        "recognition": "TemplateMatch",
        "template": "sport/cas_username_field.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["SportLogin-CAS输入用户名"]
    },
    "SportLogin-CAS输入用户名": {
        "recognition": "DirectHit",
        "action": "InputText",
        "input_text": "",
        "pre_delay": 500,
        "next": ["SportLogin-CAS收键盘1"]
        // input_text 由 run_task.py 经 pipeline_override 注入学号，禁止写入本文件
    },
    "SportLogin-CAS收键盘1": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [360, 55],
        "pre_delay": 500,
        "next": ["SportLogin-CAS密码"]
        // 点 webview 顶栏空白收起软键盘，恢复 password 字段布局（点 (40,42)-(174,176) 返回键之外）
    },
    "SportLogin-CAS密码": {
        "recognition": "TemplateMatch",
        "template": "sport/cas_password_field.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["SportLogin-CAS输入密码"]
    },
    "SportLogin-CAS输入密码": {
        "recognition": "DirectHit",
        "action": "InputText",
        "input_text": "",
        "pre_delay": 500,
        "next": ["SportLogin-CAS收键盘2"]
        // input_text 由 run_task.py 经 pipeline_override 注入密码
    },
    "SportLogin-CAS收键盘2": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [360, 55],
        "pre_delay": 500,
        "next": ["SportLogin-CAS提交"]
    },
    "SportLogin-CAS提交": {
        "recognition": "TemplateMatch",
        "template": "sport/cas_submit_btn.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["SportLogin-已登录主页"]
        // TODO: 登录失败/2FA（验证码/滑块/设备验证）分支——超时走 on_error 停链并报告
    },

    "StartEmulation": {
        "recognition": "DirectHit",
        "action": "StartApp",
        "package": "com.zhufucdev.motion_emulator",
        "timeout": 60000,
        "next": ["StartEmulation-运行确认", "StartEmulation-表单就绪", "StartEmulation-需滚动", "StartEmulation-主页滚动"]
        // app 可能直接停在 EmulateActivity（上次表单）、回 MainActivity 首页顶部（冷启动实测），
        // 或停在上次滚动位置的主页
    },
    "StartEmulation-主页滚动": {
        "recognition": "OCR",
        "expected": ["此应用已就绪"],
        "action": "Swipe",
        "begin": [360, 900],
        "end": [360, 250],
        "next": ["StartEmulation-运行确认", "StartEmulation-表单就绪", "StartEmulation-需滚动", "StartEmulation-主页滚动"]
        // 冷启动实测：主页首屏看不到 模拟 卡（列表最底部）。OCR 锚定顶部「此应用已就绪」卡，
        // 上滑一屏；模拟卡可见后下一轮由 需滚动 分支点击。self 兜底继续滚动
    },
    "StartEmulation-需滚动": {
        "recognition": "TemplateMatch",
        "template": "sport/sim_card.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["StartEmulation-表单就绪"]
    },
    "StartEmulation-表单就绪": {
        "recognition": "TemplateMatch",
        "template": "sport/sim_run_btn.png",
        "threshold": 0.8,
        "action": "DoNothing",
        "next": ["StartEmulation-聚焦圈数"]
        // 路线 dropdown_trace 需已有录制路线（模板实例已选）；未选则此链超时失败
    },
    "StartEmulation-聚焦圈数": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [360, 819],
        "pre_delay": 500,
        "next": ["StartEmulation-清空圈数"]
        // input_repeat_count 输入框原生 [128,1528][1312,1750] -> 720p 中心 (360,819)
    },
    "StartEmulation-清空圈数": {
        "recognition": "DirectHit",
        "action": "ClickKey",
        "key": [123, 67, 67, 67, 67, 67, 67, 67, 67],
        "pre_delay": 300,
        "next": ["StartEmulation-输入圈数"]
        // MOVE_END 到行尾 + DEL x8 清空旧值（1-2 位数字足够）
    },
    "StartEmulation-输入圈数": {
        "recognition": "DirectHit",
        "action": "InputText",
        "input_text": "8",
        "pre_delay": 300,
        "next": ["StartEmulation-收键盘"]
        // 默认 8 圈(3.2km)；run_task.py 可经 MAF_LAPS env 覆盖（2.4km -> 6）
    },
    "StartEmulation-收键盘": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [360, 100],
        "pre_delay": 300,
        "next": ["StartEmulation-点开始"]
        // 点标题栏空白收起软键盘（老 skill 实测 tap 720,200 原生 -> 720p (360,100)）
    },
    "StartEmulation-点开始": {
        "recognition": "TemplateMatch",
        "template": "sport/sim_run_btn.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["StartEmulation-运行确认"]
    },
    "StartEmulation-运行确认": {
        "recognition": "TemplateMatch",
        "template": ["sport/sim_running_card.png", "sport/sim_waiting_card.png", "sport/sim_cancelled_card.png"],
        "threshold": 0.8,
        "action": "DoNothing",
        "next": ["StartExercise"]
        // 启动后先"正在等待模拟"（等体育 app 消费模拟 GPS），FullRun 里由
        // StartExercise 接力后转"模拟正在进行"。若秒变"模拟已取消"说明
        // 40s 消费窗口超时——StartExercise 必须紧跟其后。
        // sim_cancelled_card 挂在这里仅为可辨识（命中即视为成功返回，由 wait 层判死）
    },

    "StartExercise": {
        "recognition": "DirectHit",
        "action": "StartApp",
        "package": "net.crigh.xbgysport",
        "timeout": 30000,
        "next": ["StartExercise-孤儿锻炼", "StartExercise-入口", "StartExercise-开始栏", "StartExercise-白名单引导", "StartExercise-继续弹窗", "StartExercise-异常记录弹窗"]
        // 合法起点：孤儿锻炼（上次中断残留的运动中页，必须停止保存后重新开始，用户要求
        // 绝不 继续运动）/ 主页 / 课外锻炼页（栈恢复）/ 白名单引导页 / 时段提示弹窗 / 异常记录弹窗
    },
    // ---- 孤儿锻炼处置：点红色停止 -> 结束单确认 -> 保存 -> 返回重新开始 ----
    "StartExercise-孤儿锻炼": {
        "recognition": "OCR",
        "expected": ["运动中", "暂停"],
        "roi": [0, 0, 720, 1280],
        "action": "DoNothing",
        "next": ["StartExercise-孤儿停止"]
        // StartApp 一进来就是运动中页 = 上次中断的残留锻炼（正常保存过的轮次不会出现）
    },
    "StartExercise-孤儿停止": {
        "recognition": "TemplateMatch",
        "template": "sport/stop_btn.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["StartExercise-孤儿确认结束", "StartExercise-孤儿停止"]
        // 红色停止键 -> 运动暂停中 + 结束单（60s 倒计时）
    },
    "StartExercise-孤儿确认结束": {
        "recognition": "TemplateMatch",
        "template": "sport/confirm_end_btn.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["StartExercise-异常保存落地", "StartExercise-入口", "StartExercise-开始栏", "StartExercise-继续弹窗", "StartExercise-异常记录弹窗"]
    },
    "StartExercise-异常记录弹窗": {
        "recognition": "OCR",
        "expected": ["检测到异常记录", "异常记录"],
        "action": "DoNothing",
        "next": ["StartExercise-异常记录停止"]
        // 「检测到异常记录」弹窗（上次意外退出遗留未完成记录）：先锚弹窗文本确认语境，
        // 再由下一步点按钮。绝不点 继续运动（用户明确要求——续跑会产生被污染的记录）
    },
    "StartExercise-异常记录停止": {
        "recognition": "OCR",
        "expected": ["停止", "去保存", "去 保存"],
        "roi": [60, 300, 600, 700],
        "action": "Click",
        "next": ["StartExercise-异常保存落地", "StartExercise-入口", "StartExercise-开始栏", "StartExercise-继续弹窗"]
        // 异常弹窗的操作按钮实测文案为 停止（点它=保存残缺记录并退出）；
        // 仅在 异常记录弹窗 命中后的语境下轮询，时段弹窗（继续运动）不会走到这里
    },
    "StartExercise-异常保存落地": {
        "recognition": "OCR",
        "expected": "平均配速",
        "roi": [0, 400, 720, 400],
        "action": "Click",
        "target": [53, 54],
        "next": ["StartExercise-入口", "StartExercise-开始栏", "StartExercise-继续弹窗", "StartExercise-异常记录弹窗", "StartExercise-异常保存落地"]
        // 保存后落在残缺记录详情页：点左上返回退出，重新走 开始锻炼 链
    },
    "StartExercise-白名单引导": {
        "recognition": "TemplateMatch",
        "template": "sport/whitelist_title.png",
        "threshold": 0.8,
        "action": "Click",
        "target": [53, 54],
        "next": ["StartExercise-入口", "StartExercise-开始栏", "StartExercise-白名单引导", "StartExercise-继续弹窗", "StartExercise-异常记录弹窗"]
        // 「安卓手机后台运行白名单设置方法」整页引导：冷启动或点入口后都可能出现，
        // 点左上返回箭头（原生 [40,42][174,176] -> 720p 中心 (53,54)）自旋退出；
        // 返回后可能落主页也可能落在课外锻炼页（activity 栈恢复），两者都在 next 里
    },
    "StartExercise-入口": {
        "recognition": "TemplateMatch",
        "template": "sport/home_exercise_entry.png",
        "roi": [0, 500, 720, 620],
        "threshold": 0.8,
        "action": "Click",
        "next": ["StartExercise-开始栏", "StartExercise-白名单引导", "StartExercise-继续弹窗", "StartExercise-异常记录弹窗"]
    },
    "StartExercise-开始栏": {
        "recognition": "TemplateMatch",
        "template": "sport/exercise_start_bar.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["StartExercise-区域范围", "StartExercise-白名单引导", "StartExercise-继续弹窗", "StartExercise-异常记录弹窗"]
    },
    "StartExercise-区域范围": {
        "recognition": "TemplateMatch",
        "template": "sport/exercise_area_option.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["StartExercise-场地", "StartExercise-白名单引导", "StartExercise-异常记录弹窗"]
    },
    "StartExercise-场地": {
        "recognition": "TemplateMatch",
        "template": "sport/field_xingtianyuan.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["StartExercise-续跑孤儿检测", "StartExercise-运动确认", "StartExercise-继续弹窗", "StartExercise-白名单引导", "StartExercise-异常记录弹窗"]
    },
    "StartExercise-续跑孤儿检测": {
        "recognition": "Custom",
        "custom_recognition": "resumed_orphan",
        "action": "DoNothing",
        "next": ["StartExercise-孤儿停止"]
        // agent/my_reco.py：实测踩坑——强停后重新开始锻炼，app 可能弹 继续运动 把残留
        // 锻炼续上（计时保留、含空档）。本识别在 运动确认 前判断：运动中页但 时长>=4min
        // 或 公里>=0.3 = 残留续跑，转 孤儿停止 链丢弃重开；新开锻炼（秒级计时）不命中，
        // 落到 运动确认 正常等待
    },
    "StartExercise-继续弹窗": {
        "recognition": "TemplateMatch",
        "template": "sport/dialog_continue_btn.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["StartExercise-运动确认", "StartExercise-白名单引导", "StartExercise-异常记录弹窗"]
        // 「根据学校规定，当前时间不在规定有效锻炼时间内，是否继续锻炼?」弹窗：
        // 非有效锻炼时段（晚间）必现，此处点 继续运动 是正确处理。
        // 注意：「检测到异常记录」弹窗不走这里（按钮文字不同，模板不匹配），
        // 由 异常记录弹窗 节点 OCR 去保存 处理
    },
    "StartExercise-运动确认": {
        "recognition": "OCR",
        "expected": ["运动中", "暂停"],
        "roi": [0, 0, 720, 1280],
        "action": "DoNothing",
        "next": ["WaitExerciseFinish"]
        // 运动中页：标题 运动中 + 暂停 按钮字样任一命中即确认（OCR 实测）；
        // 刚启动时配速可能无值，不作为锚点
    },

    "WaitExerciseFinish": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "wait_exercise_finish",
        "custom_action_param": {
            "poll_sec": 30,
            "max_wait_sec": 2700,
            "target_km": 3.3,
            "stall_sec": 240,
            "blank_limit": 5
        },
        "next": ["StopExercise"]
        // agent/my_wait.py：纯被动轮询（截屏+OCR，不点击）。实测：锻炼不会自动结束，
        // 里程超目标也一直计时，必须人工停止并在 60s 倒计时内确认保存。
        // 顶部统计区 总公里数 >= target_km -> True -> StopExercise（停止+保存）。
        // target_km = 校要求 +0.1km 余量（3.3 = 3.2+0.1；2.4 场景 run_task.py 经
        // MAF_TARGET_KM=2.5 覆盖，配 MAF_LAPS=6）——落库值在显示值基础上略有出入，
        // 留余量防止 卡线不达标而无效。
        // 未达标但距离停滞（stall_sec 无增长 = 模拟已取消早死）/ 页面消失 / 超时 -> False，
        // on_error 保持为空让任务以失败终止。
    },

    // ---- 停止并保存锻炼（实测流程：点红色停止键 -> 自动暂停+结束单(60s 倒计时) -> 确认结束 -> 上传成功 -> 记录详情页）----
    "StopExercise": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "timeout": 120000,
        "next": ["StopExercise-确认结束", "StopExercise-保存确认", "StopExercise-停止按钮"]
        // 结束单可能已开着（重入），先试 确认结束；再试记录页已出现（保存完成）；
        // 都没有则点停止键拉起结束单
