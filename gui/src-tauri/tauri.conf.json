{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAF Motion Emulator",
  "version": "0.2.0",
  "identifier": "com.mafmotion.emulator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MAF Motion Emulator",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../tools": "tools",
      "../../agent": "agent",
      "../../assets": "assets",
      "../scripts": "gui/scripts",
      "../tools/nemu": "gui/tools/nemu",
      "../../README.md": "README.md",
      "../../docs": "docs"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
