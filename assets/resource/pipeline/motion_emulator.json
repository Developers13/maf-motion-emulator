{
    // 初版骨架：任务链已定，识别细节（TemplateMatch/OCR + 图像素材）待实测截图后填充。
    // 协议文档：https://maafw.com/docs/3.1-PipelineProtocol
    //
    // 业务背景（来自 motion-emulate-automation 的实测经验）：
    // - 西工大体育 (net.crigh.xbgysport)：首次启动有 隐私协议弹窗(同意) → 引导页(3次左滑 → tv_start)
    //   → 登录页(勾选 checkRule 协议 → btn_login 进 CAS webview → username/password → 登录)
    // - Motion Emulator (com.zhufucdev.motion_emulator)：首页是单列滚动卡片，模拟 卡在最底部
    //   → 表单 dropdown_trace(需已选路线) / input_repeat_count(2.4km→6, 3.2km→8) / btn_run_emulation
    // - MuMu 多 display：app 可能落在副屏，操作前需确认 display（MaaFW Adb 控制器已处理截图/输入路由）
    //
    // "FullRun": 登录 → 启动模拟 → 开始锻炼 → 等待锻炼结束 的完整链路

    "FullRun": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": ["SportLogin"]
    },
    "SportLogin": {
        "recognition": "DirectHit",
        "action": "StartApp",
        "package": "net.crigh.xbgysport",
        "timeout": 30000,
        "next": [
            "SportLogin-已登录主页",
            "SportLogin-已运动中",
            "SportLogin-隐私协议",
            "SportLogin-登录页勾选"
        ]
        // 状态机：StartApp 后按序轮询，首个命中进入对应分支。
        // 注意：引导页节点刻意不在此列表——首启时 WelcomeActivity 会先渲染引导
        // ViewPager、隐私弹窗延迟数秒才盖上（实测踩坑：引导页抢命中→未同意协议
        // 点开始→app 退出）。引导页只能从"已同意"（隐私协议.next）进入。
    },

    // ---- 已登录分支 ----
    "SportLogin-已登录主页": {
        "recognition": "TemplateMatch",
        "template": "sport/home_exercise_entry.png",
        "roi": [0, 500, 720, 620],
        "threshold": 0.8,
        "action": "DoNothing",
        "next": ["StartEmulation"]
    },

    // FullRun 重跑保护：已在运动中（上轮链完成/中断恢复）直接跳到模拟段
    "SportLogin-已运动中": {
        "recognition": "OCR",
        "expected": ["暂停", "配速"],
        "roi": [0, 900, 720, 380],
        "action": "DoNothing",
        "next": ["StartEmulation"]
    },

    // ---- 首启隐私弹窗（同意/拒绝）----
    "SportLogin-隐私协议": {
        "recognition": "TemplateMatch",
        "template": "sport/privacy_agree_btn.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["SportLogin-引导页", "SportLogin-登录页勾选", "SportLogin-已登录主页"]
    },

    // ---- 引导页（实测 tv_start 首页即可见，直接点击跳过，无需左滑）----
    "SportLogin-引导页": {
        "recognition": "TemplateMatch",
        "template": "sport/guide_start_btn.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["SportLogin-登录页勾选", "SportLogin-已登录主页"]
    },

    // ---- 登录页：自旋勾选协议（未勾选态 checkbox 模板；勾选后不再命中），勾上后 CAS 入口变亮 ----
    "SportLogin-登录页勾选": {
        "recognition": "TemplateMatch",
        "template": "sport/login_checkrule.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["SportLogin-打开CAS", "SportLogin-登录页勾选"]
    },

    // 勾选后的亮态入口按钮（灰态匹配不到，天然防误点）
    "SportLogin-打开CAS": {
        "recognition": "TemplateMatch",
        "template": "sport/cas_entry_active.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["SportLogin-CAS用户名"]
    },

    // ---- CAS 统一身份认证 webview ----
    "SportLogin-CAS用户名": {
        "recognition": "TemplateMatch",
        "template": "sport/cas_username_field.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["SportLogin-CAS输入用户名"]
    },
    "SportLogin-CAS输入用户名": {
        "recognition": "DirectHit",
        "action": "InputText",
        "input_text": "",
        "pre_delay": 500,
        "next": ["SportLogin-CAS收键盘1"]
        // input_text 由 run_task.py 经 pipeline_override 注入学号，禁止写入本文件
    },
    "SportLogin-CAS收键盘1": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [360, 55],
        "pre_delay": 500,
        "next": ["SportLogin-CAS密码"]
        // 点 webview 顶栏空白收起软键盘，恢复 password 字段布局（点 (40,42)-(174,176) 返回键之外）
    },
    "SportLogin-CAS密码": {
        "recognition": "TemplateMatch",
        "template": "sport/cas_password_field.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["SportLogin-CAS输入密码"]
    },
    "SportLogin-CAS输入密码": {
        "recognition": "DirectHit",
        "action": "InputText",
        "input_text": "",
        "pre_delay": 500,
        "next": ["SportLogin-CAS收键盘2"]
        // input_text 由 run_task.py 经 pipeline_override 注入密码
    },
    "SportLogin-CAS收键盘2": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [360, 55],
        "pre_delay": 500,
        "next": ["SportLogin-CAS提交"]
    },
    "SportLogin-CAS提交": {
        "recognition": "TemplateMatch",
        "template": "sport/cas_submit_btn.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["SportLogin-已登录主页"]
        // TODO: 登录失败/2FA（验证码/滑块/设备验证）分支——超时走 on_error 停链并报告
    },

    "StartEmulation": {
        "recognition": "DirectHit",
        "action": "StartApp",
        "package": "com.zhufucdev.motion_emulator",
        "timeout": 30000,
        "next": ["StartEmulation-运行确认", "StartEmulation-表单就绪", "StartEmulation-需滚动"]
        // app 可能直接停在 EmulateActivity（上次表单）或回 MainActivity 首页
    },
    "StartEmulation-需滚动": {
        "recognition": "TemplateMatch",
        "template": "sport/sim_card.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["StartEmulation-表单就绪"]
    },
    "StartEmulation-表单就绪": {
        "recognition": "TemplateMatch",
        "template": "sport/sim_run_btn.png",
        "threshold": 0.8,
        "action": "DoNothing",
        "next": ["StartEmulation-聚焦圈数"]
        // 路线 dropdown_trace 需已有录制路线（模板实例已选）；未选则此链超时失败
    },
    "StartEmulation-聚焦圈数": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [360, 819],
        "pre_delay": 500,
        "next": ["StartEmulation-清空圈数"]
        // input_repeat_count 输入框原生 [128,1528][1312,1750] -> 720p 中心 (360,819)
    },
    "StartEmulation-清空圈数": {
        "recognition": "DirectHit",
        "action": "ClickKey",
        "key": [123, 67, 67, 67, 67, 67, 67, 67, 67],
        "pre_delay": 300,
        "next": ["StartEmulation-输入圈数"]
        // MOVE_END 到行尾 + DEL x8 清空旧值（1-2 位数字足够）
    },
    "StartEmulation-输入圈数": {
        "recognition": "DirectHit",
        "action": "InputText",
        "input_text": "8",
        "pre_delay": 300,
        "next": ["StartEmulation-收键盘"]
        // 默认 8 圈(3.2km)；run_task.py 可经 MAF_LAPS env 覆盖（2.4km -> 6）
    },
    "StartEmulation-收键盘": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [360, 100],
        "pre_delay": 300,
        "next": ["StartEmulation-点开始"]
        // 点标题栏空白收起软键盘（老 skill 实测 tap 720,200 原生 -> 720p (360,100)）
    },
    "StartEmulation-点开始": {
        "recognition": "TemplateMatch",
        "template": "sport/sim_run_btn.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["StartEmulation-运行确认"]
    },
    "StartEmulation-运行确认": {
        "recognition": "TemplateMatch",
        "template": ["sport/sim_running_card.png", "sport/sim_waiting_card.png", "sport/sim_cancelled_card.png"],
        "threshold": 0.8,
        "action": "DoNothing",
        "next": ["StartExercise"]
        // 启动后先"正在等待模拟"（等体育 app 消费模拟 GPS），FullRun 里由
        // StartExercise 接力后转"模拟正在进行"。若秒变"模拟已取消"说明
        // 40s 消费窗口超时——StartExercise 必须紧跟其后。
        // sim_cancelled_card 挂在这里仅为可辨识（命中即视为成功返回，由 wait 层判死）
    },

    "StartExercise": {
        "recognition": "DirectHit",
        "action": "StartApp",
        "package": "net.crigh.xbgysport",
        "timeout": 30000,
        "next": ["StartExercise-运动确认", "StartExercise-入口", "StartExercise-开始栏", "StartExercise-白名单引导", "StartExercise-继续弹窗"]
        // 五个合法起点：已运动中（OCR 暂停/配速）/ 主页 / 课外锻炼页（栈恢复）/
        // 白名单引导页 / 通用系统提示弹窗
    },
    "StartExercise-白名单引导": {
        "recognition": "TemplateMatch",
        "template": "sport/whitelist_title.png",
        "threshold": 0.8,
        "action": "Click",
        "target": [53, 54],
        "next": ["StartExercise-入口", "StartExercise-开始栏", "StartExercise-白名单引导", "StartExercise-继续弹窗"]
        // 「安卓手机后台运行白名单设置方法」整页引导：冷启动或点入口后都可能出现，
        // 点左上返回箭头（原生 [40,42][174,176] -> 720p 中心 (53,54)）自旋退出；
        // 返回后可能落主页也可能落在课外锻炼页（activity 栈恢复），两者都在 next 里
    },
    "StartExercise-入口": {
        "recognition": "TemplateMatch",
        "template": "sport/home_exercise_entry.png",
        "roi": [0, 500, 720, 620],
        "threshold": 0.8,
        "action": "Click",
        "next": ["StartExercise-开始栏", "StartExercise-白名单引导", "StartExercise-继续弹窗"]
    },
    "StartExercise-开始栏": {
        "recognition": "TemplateMatch",
        "template": "sport/exercise_start_bar.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["StartExercise-区域范围", "StartExercise-白名单引导", "StartExercise-继续弹窗"]
    },
    "StartExercise-区域范围": {
        "recognition": "TemplateMatch",
        "template": "sport/exercise_area_option.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["StartExercise-场地", "StartExercise-白名单引导"]
    },
    "StartExercise-场地": {
        "recognition": "TemplateMatch",
        "template": "sport/field_xingtianyuan.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["StartExercise-运动确认", "StartExercise-继续弹窗", "StartExercise-白名单引导"]
    },
    "StartExercise-继续弹窗": {
        "recognition": "TemplateMatch",
        "template": "sport/dialog_continue_btn.png",
        "threshold": 0.8,
        "action": "Click",
        "next": ["StartExercise-运动确认", "StartExercise-白名单引导"]
        // 通用「系统提示」弹窗（按钮均为 继续运动）：非有效锻炼时段（晚间必现）或
        // 「检测到有异常记录」续跑提示；有效时段且无异常时轮询直接命中运动确认
    },
    "StartExercise-运动确认": {
        "recognition": "OCR",
        "expected": ["暂停", "配速"],
        "roi": [0, 900, 720, 380],
        "action": "DoNothing",
        "next": ["WaitExerciseFinish"]
        // 运动中地图页底部数据卡：暂停按钮常驻（刚启动配速可能无值，实测踩坑），
        // OCR 任一命中即确认；ROI 覆盖底部卡片区
    },

    "WaitExerciseFinish": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "wait_exercise_finish",
        "custom_action_param": {
            "poll_sec": 60,
            "max_wait_sec": 2700,
            "stall_sec": 180,
            "blank_limit": 5
        },
        "next": []
        // agent/my_wait.py：纯被动轮询（截屏+OCR，不点击）。结束页锚点命中 -> next（保存流程待接）；
        // 距离停滞（stall_sec 内无增长 = 模拟已取消/GPS 冻结）/ 页面消失 / 超时 -> 返回 False，
        // on_error 保持为空让任务以失败终止。
        // 老 skill 实测：模拟死后「模拟正在进行」通知仍会存活数分钟，总公里数冻结才是可靠死信号。
    }
}
